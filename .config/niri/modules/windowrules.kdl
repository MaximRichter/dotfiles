window-rule {
    opacity 0.85
    geometry-corner-radius 10
    clip-to-geometry true
    open-maximized false
    open-maximized-to-edges false
    
    background-effect {
        blur false
        xray false
    }
}

window-rule {
    // Steam / Proton
    match app-id=r#"^steam_app_\d+$"#

    // Wine-игры, включая большинство игр из Lutris
    match app-id=r#"(?i)\.exe$"#

    variable-refresh-rate true
}

window-rule {
    match app-id=r"^org\.pulseaudio\.pavucontrol"
    open-floating true
}

window-rule {
    match app-id=r"^$" title=r"^(Picture in picture|Save File|Open File|Steam - Self Updater)$"
    open-floating true
}

window-rule {
    match app-id=r"^LibreWolf$" title=r"^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match title=r"^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id=r"^blueman-manager$"
    open-floating true
}

window-rule {
    match app-id=r"^(xdg-desktop-portal-gtk|xdg-desktop-portal-kde|xdg-desktop-portal-hyprland).*$"
    open-floating true
}

window-rule {
    match app-id=r"^(polkit-gnome-authentication-agent-1|hyprpolkitagent|org\.kde\.polkit-kde-authentication-agent-1).*$"
    open-floating true
}

window-rule {
    match app-id=r"^CachyOSHello$"
    open-floating true
}

window-rule {
    match app-id=r"^zenity$"
    open-floating true
}

window-rule {
    match title=r"^(imv|mpv|danmufloat|termfloat|nemo|ncmpcpp)$"
    open-floating true
}

window-rule {
    match app-id=r#"^mpv$"#
    opacity 1.0
}

// Yomipv creates transparent auxiliary windows while the selector is active.
// Under pointer focus, niri must not activate each newly mapped window: doing
// so makes mpv hide it, then regain focus, producing an endless flash loop.
window-rule {
    match app-id=r#"^yomipv-lookup$"#
    open-floating true
    open-focused false
    opacity 1.0
}
