output "DP-2" {
    // off
    mode "1920x1080@60"
    scale 1
    position x=0 y=360
    transform "normal"

    hot-corners {
        off
    }

    layout {
        default-column-width { proportion 0.5; }
    }
}

output "DP-1" {
    // off
    mode "3440x1440@144"
    scale 1
    position x=1920 y=0
    transform "normal"
    variable-refresh-rate on-demand=true

    hot-corners {
        off
    }

    layout {
        default-column-width { proportion 0.33333; }
        preset-column-widths {
            proportion 0.25;
            proportion 0.33333;
            proportion 0.5;
            proportion 0.66667;}
        }
}
