{
    "layer": "top",
    "output": "DP-2",
    "position": "top",
    "height": 37,
    "spacing": 5,
    "margin-left": 10,
    "margin-top": 0,
    "margin-right": 10,
    "margin-bottom": 0,
    "modules-left": [
        "hyprland/workspaces",
        "custom/media"
    ],
    "modules-center": [
        "clock#date"
    ],
    "modules-right": [
        "custom/vpn",
        "wireplumber",
        "custom/mic",
        "tray",
        "custom/power"
    ],
    "hyprland/workspaces": {
        "all-outputs": false,
        "format": "{name}",
        "on-scroll-up": "hyprctl dispatch workspace e+1 1>/dev/null",
        "on-scroll-down": "hyprctl dispatch workspace e-1 1>/dev/null",
        "sort-by-number": true,
        "active-only": false
    },
    "clock#date": {
        "format": " {:%Y-%m-%d 󰥔 %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "today-format": "<b>{}</b>"
    },
    "custom/media": {
        "exec": "~/.config/waybar/mediaplayer.py",
        "format": "{} <span foreground='#CCB395'></span> ",
        "return-type": "json",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },
    "wireplumber": {
        "on-click": "pavucontrol",
        "on-click-right": "amixer sset Master toggle 1>/dev/null",
        "format": "<span foreground='#CCB395'>{icon}</span>  {volume}%",
        "format-muted": " ",
        "format-source": "",
        "format-source-muted": "",
        "format-icons": {
            "headphone": " ",
            "hands-free": " ",
            "headset": " ",
            "phone": " ",
            "portable": " ",
            "car": " ",
            "default": [
                " ",
                " ",
                " "
            ]
        }
    },
    "custom/vpn": {
        "return-type": "json",
        "format": "<span foreground='#CCB395'>󰖂</span> {}",
        "interval": 10,
        "signal": 10,
        "exec": "~/.config/waybar/modules/vpn.sh",
        "on-click": "~/.local/scripts/vpn-picker.sh"
    },
    "custom/mic": {
        "exec": "~/.config/waybar/modules/mic.sh",
        "return-type": "json",
        "interval": "once",
        "signal": 11,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && pkill -RTMIN+11 waybar"
    },

    "custom/power": {
        "format": " 󰐥 ",
        "tooltip": false,
        "on-click": "~/.config/rofi/powermenu/type-1/powermenu.sh"
    },
    "tray": {
        "icon-size": 14,
        "spacing": 6
    }
}
